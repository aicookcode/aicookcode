---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeatureModules from '../components/FeatureModules.astro';
import { ArrowRight, ArrowUpRight, CodeXml, Rss, Sparkles, GitBranch, Globe, Terminal } from '@lucide/astro';
import { categories } from '../config/site';
import { dateLabel, getPosts, postPath } from '../lib/posts';
const posts = await getPosts();
const featuredPosts = posts
  .filter((post) => post.data.featured)
  .sort(
    (a, b) =>
      (a.data.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
      (b.data.featuredOrder ?? Number.MAX_SAFE_INTEGER)
  )
  .slice(0, 4);
const featured = featuredPosts[0] ?? posts[0];
const starterPosts = featuredPosts.slice(1, 4);
const latestPosts = posts.filter((post) => post.id !== featured?.id).slice(0, 6);
const topicIcons = [Sparkles, GitBranch, Globe, Terminal];
---
<BaseLayout title="AICookCode｜AI 应用、编程实践与独立开发" description="记录 AI 应用、编程实践、独立建站和开发工具，分享从想法到上线的真实过程。">
  <div class="container home-page">
    <section class="home-intro" aria-labelledby="home-title"><div><h1 id="home-title">把想法煮成代码，<br /><span>把实践写成笔记。</span></h1><p>记录 AI 应用、GitHub 实践、独立建站和开发工具，分享从想法到上线的真实过程。</p></div></section>
    {featured && <section class="featured-layout" aria-label="精选文章"><a class="feature-story" href={postPath(featured)}><img src={featured.data.cover} alt={featured.data.coverAlt} width="1400" height="934" fetchpriority="high" /><span class="feature-bottom-shade" aria-hidden="true"></span><div class="feature-top"><span class="feature-badge"><Sparkles size={13} /> 精选文章</span><span class="feature-issue">NO. {String(featured.data.featuredOrder ?? 1).padStart(3, '0')}</span></div><div class="feature-copy"><span class="feature-category">{featured.data.category}<span>/</span>{dateLabel(featured.data.pubDate)}</span><h2>{featured.data.title}</h2></div></a><aside class="start-here"><h2>精选文章</h2><div class="starting-list">{starterPosts.map((post, index) => <a href={postPath(post)}><span><span class="start-category">{post.data.category}</span><h3>{post.data.title}</h3></span><ArrowUpRight size={16} /></a>)}</div><a class="start-bottom" href="/articles/">浏览全部文章 <ArrowRight size={15} /></a></aside></section>}
    <section class="latest-section" aria-labelledby="latest-title"><div class="section-heading"><div><h2 id="latest-title">最新文章</h2></div><a class="text-link" href="/articles/">查看全部 <ArrowUpRight size={17} /></a></div><div class="posts-grid">{latestPosts.map((post) => <PostCard post={post} />)}</div></section>
  </div>
  <FeatureModules />
  <section class="topics-section" aria-labelledby="topics-title"><div class="container"><div class="section-heading"><div><h2 id="topics-title">找到你的探索方向</h2></div><a class="text-link" href="/topics/">全部专题 <ArrowUpRight size={17} /></a></div><div class="topic-grid">{categories.map((category, index) => { const Icon = topicIcons[index]; return <a class={`topic-item ${category.color}`} href={`/topics/${category.slug}/`}><span class="topic-icon"><Icon size={21} /></span><div><h3>{category.name}<ArrowUpRight size={15} /></h3><p>{category.description}</p></div></a>; })}</div></div></section>
  <section class="rss-band"><div class="container rss-inner"><div class="rss-heading"><span class="rss-icon"><Rss size={22} /></span><div><h2>订阅这份开发笔记</h2><p>用 RSS 获取新文章，不错过每一次实践更新。</p></div></div><a class="button button-dark" href="/rss.xml">订阅 RSS <ArrowUpRight size={16} /></a></div></section>
</BaseLayout>
