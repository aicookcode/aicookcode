---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../config/site';
import { getPosts } from '../../lib/posts';
import { ArrowLeft } from '@lucide/astro';
export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.category === category.name);
---
<BaseLayout title={`${category.name} · AICookCode`} description={category.description} noindex><div class="container archive-page"><header class="page-heading"><a class="back-link" href="/topics/"><ArrowLeft size={16} />全部专题</a><h1>{category.name}<span class="heading-dot">.</span></h1><p>{category.description} <span class="muted">/ {posts.length} 篇笔记</span></p></header><div class="posts-grid">{posts.map((post) => <PostCard post={post} />)}</div></div></BaseLayout>
