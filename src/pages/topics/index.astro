---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../config/site';
import { getPosts } from '../../lib/posts';
import FocusTopics from '../../components/FocusTopics.astro';
import ContentTracks from '../../components/ContentTracks.astro';
import { ArrowUpRight, Sparkles, GitBranch, Globe, Terminal } from '@lucide/astro';
const posts = await getPosts();
const icons = [Sparkles, GitBranch, Globe, Terminal];
---
<BaseLayout title="阅读主线与专题：AI 实测、独立建站与工作流 · AICookCode" description="先沿 AI 工具真实实测、独立建站上线复盘、普通用户可复现工作流选择教程，也可按原有 AI 应用、GitHub 实践、建站笔记和开发工具分类浏览。"><div class="container archive-page"><header class="page-heading"><span class="eyebrow">IDEAS, ORGANIZED</span><h1>找到你的下一个探索方向<span class="heading-dot">.</span></h1><p>先选一条实践主线，再按具体任务和分类继续阅读。</p></header>
  <ContentTracks />
  <div class="topic-directory">{categories.map((category, index) => { const Icon = icons[index]; return <a class={`topic-directory-item ${category.color}`} href={`/topics/${category.slug}/`}><span class="topic-icon"><Icon size={30} /></span><span class="topic-directory-number">0{index + 1}</span><h2>{category.name}</h2><p>{category.description}</p><div><span>{posts.filter((post) => post.data.category === category.name).length} 篇笔记</span><ArrowUpRight size={23} /></div></a>; })}</div>
<FocusTopics /></div></BaseLayout>
