---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { ArrowLeft } from '@lucide/astro';
export async function getStaticPaths() { const posts = await getPosts(); return [...new Set(posts.flatMap((post) => post.data.tags))].map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } })); }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag} · AICookCode`}><div class="container archive-page"><header class="page-heading"><a class="back-link" href="/articles/"><ArrowLeft size={16} />全部文章</a><h1><span class="heading-dot">#</span>{tag}</h1><p>围绕 {tag} 的 {posts.length} 篇实践笔记。</p></header><div class="posts-grid">{posts.map((post) => <PostCard post={post} />)}</div></div></BaseLayout>
