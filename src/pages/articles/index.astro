---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PostFilters from '../../components/PostFilters.astro';
import { getPosts } from '../../lib/posts';
import { ArrowUp } from '@lucide/astro';
const posts = await getPosts();
---
<BaseLayout title="AI 编程与工具教程：WorkBuddy、数字人与开源实践 · AICookCode" description="浏览 WorkBuddy 小程序开发与上线、AI 数字人口播、本地声音克隆、UI 素材提取和开源项目教程，按实操步骤完成从配置到验收。">
  <a class="article-back-top article-list-back-top is-hidden" href="#top" aria-label="回到顶部" title="回到顶部"><ArrowUp size={18} stroke-width={2.25} /></a>
  <div class="container archive-page"><header class="page-heading"><span class="eyebrow">THE NOTEBOOK</span><h1>每一次实践，都值得记录<span class="heading-dot">.</span></h1><p>从一个想法开始，在一行行代码里找到答案。</p></header>
  <div class="filter-row"><PostFilters /><span class="article-count" data-post-count>{posts.length} 篇文章</span></div>
  <div class="posts-grid">{posts.map((post) => <PostCard post={post} />)}</div><p class="empty-state" data-empty-state hidden>这个专题还没有文章，新的笔记正在路上。</p></div>
</BaseLayout>
<script>
  const backTop = document.querySelector<HTMLAnchorElement>('.article-list-back-top');
  function updateBackTop() { backTop?.classList.toggle('is-hidden', scrollY < 120); }
  addEventListener('scroll', updateBackTop, { passive: true });
  updateBackTop();
</script>
