    <div class="footer-links"><a href="/articles/">全部文章</a><a href="/about/">关于本站</a><a href="/contact/">联系</a><a href="/privacy/">隐私政策</a><a href="/rss.xml"><Rss size={15} /> RSS 订阅</a><a href={site.githubUrl || 'https://github.com'} target="_blank" rel="noopener noreferrer"><Github size={15} /> GitHub <ArrowUpRight size={13} /></a></div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} AICookCode</span><span><a href="/terms/">服务条款</a><span class="dot-divider">·</span><a href="/disclaimer/">免责声明</a></span><a href="#top" class="back-top">回到顶部 ↑</a></div>
