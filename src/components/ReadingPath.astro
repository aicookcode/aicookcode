---
import { learningPaths } from '../config/learning-paths';
import { focusTopics } from '../config/focus-topics';
import { postPath, type Post } from '../lib/posts';
interface Props { post: Post; posts: Post[]; }
const { post, posts } = Astro.props;
const path = learningPaths.find((path) => path.steps.some((step) => step.id === post.id));
const topic = focusTopics.find((topic) => topic.steps.some((step) => step.id === post.id));
const sequence = path ?? topic;
const sequenceTitle = path?.title ?? topic?.name;
const steps = sequence?.steps.flatMap((step) => {
  const entry = posts.find((item) => item.id === step.id);
  return entry ? [entry] : [];
}) ?? [];
const current = steps.findIndex((item) => item.id === post.id);
const categoryPosts = posts.filter((item) => item.data.category === post.data.category);
const categoryIndex = categoryPosts.findIndex((item) => item.id === post.id);
const newer = categoryIndex > 0 ? categoryPosts[categoryIndex - 1] : undefined;
const older = categoryIndex >= 0 ? categoryPosts[categoryIndex + 1] : undefined;
---
{sequence && steps.length > 1 && <nav class="reading-path" aria-label="推荐阅读顺序">
  <p>阅读顺序：{sequenceTitle}</p>
  <ol>{steps.map((item) => <li>{item.id === post.id ? <span aria-current="step">{item.data.title}（本文）</span> : <a href={postPath(item)}>{item.data.title}</a>}</li>)}</ol>
  <div class="reading-path-neighbors">
    {current > 0 && <a href={postPath(steps[current - 1])}>上一步：{steps[current - 1].data.title}</a>}
    {current < steps.length - 1 && <a href={postPath(steps[current + 1])}>下一步：{steps[current + 1].data.title}</a>}
  </div>
</nav>}
{steps.length < 2 && (older || newer) && <nav class="reading-path" aria-label="同专题前后篇">
  <p>继续阅读同专题文章</p>
  <div class="reading-path-neighbors">
    {older && <a href={postPath(older)}>较早发布：{older.data.title}</a>}
    {newer && <a href={postPath(newer)}>较晚发布：{newer.data.title}</a>}
  </div>
</nav>}
