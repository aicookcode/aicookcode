---
import { categories } from '../config/site';
---
<div class="post-filters" role="group" aria-label="按专题筛选文章"><button class="filter-button active" data-filter="all" aria-pressed="true">全部文章</button>{categories.map((category) => <button class="filter-button" data-filter={category.slug} aria-pressed="false">{category.name}</button>)}</div>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const posts = document.querySelectorAll<HTMLElement>('.post-card[data-category]');
  const count = document.querySelector('[data-post-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  function filter(category: string, updateUrl = true) {
    if (![...filters].some((button) => button.dataset.filter === category)) category = 'all';
    filters.forEach((button) => { const active = button.dataset.filter === category; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); });
    let visible = 0;
    posts.forEach((post) => { post.hidden = category !== 'all' && post.dataset.category !== category; if (!post.hidden) visible++; });
    if (count) count.textContent = `${visible} 篇文章`;
    if (empty) empty.hidden = visible > 0;
    if (updateUrl) { const url = new URL(window.location.href); if (category === 'all') url.searchParams.delete('category'); else url.searchParams.set('category', category); history.replaceState(null, '', url); }
  }
  filters.forEach((button) => button.addEventListener('click', () => filter(button.dataset.filter!)));
  filter(new URLSearchParams(location.search).get('category') || 'all', false);
</script>
